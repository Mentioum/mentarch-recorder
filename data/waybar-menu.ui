<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkMenu" id="menu">
    <property name="name">recorder-menu</property>
    <child><object class="GtkMenuItem" id="start"><property name="label">Choose window &amp; record</property></object></child>
    <child><object class="GtkMenuItem" id="stop"><property name="label">Stop &amp; save</property></object></child>
    <child><object class="GtkMenuItem" id="cancel"><property name="label">Cancel selection</property></object></child>
    <child><object class="GtkSeparatorMenuItem"/></child>
    <child><object class="GtkMenuItem"><property name="label">Audio for next recording</property><property name="sensitive">False</property></object></child>
    <child><object class="GtkCheckMenuItem" id="toggle-mic"><property name="label">Record microphone</property><property name="active">False</property><!--MIC--></object></child>
    <child><object class="GtkCheckMenuItem" id="toggle-desktop"><property name="label">Record desktop audio</property><property name="active">False</property><!--DESKTOP--></object></child>
    <child><object class="GtkMenuItem" id="settings"><property name="label">Audio settings…</property></object></child>
    <child><object class="GtkSeparatorMenuItem"/></child>
    <child><object class="GtkMenuItem" id="open"><property name="label">Open latest video</property></object></child>
    <child><object class="GtkMenuItem" id="folder"><property name="label">Show recordings folder</property></object></child>
    <child><object class="GtkSeparatorMenuItem"/></child>
    <child><object class="GtkMenuItem" id="show"><property name="label">Show recorder controls</property></object></child>
    <child><object class="GtkMenuItem" id="quit"><property name="label">Save &amp; quit recorder</property></object></child>
  </object>
</interface>
